<Window x:Class="AppSweep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AppSweep"
        Icon="Assets/app.ico"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     MinWidth="320"
                     Margin="0,0,12,0"
                     ToolTip="Search by name, product code, version, date, or source status" />

            <ComboBox x:Name="MethodComboBox" Grid.Column="2" Width="260" Margin="0,0,12,0">
                <ComboBoxItem Content="Auto" />
                <ComboBoxItem Content="Windows Installer API" />
                <ComboBoxItem Content="msiexec.exe" />
                <ComboBoxItem Content="Orphaned Registry Cleanup" />
            </ComboBox>

            <Button x:Name="RefreshButton" Grid.Column="3" Content="Refresh List" Margin="0,0,8,0" />
            <Button x:Name="SelectAllButton" Grid.Column="4" Content="Select All" Margin="0,0,8,0" />
            <Button x:Name="DeselectAllButton" Grid.Column="5" Content="Deselect All" Margin="0,0,8,0" />
            <ProgressBar x:Name="LoadingBar" Grid.Column="6" Width="160" Height="18" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            <CheckBox x:Name="ThemeCheckBox"
                      Grid.Column="7"
                      Content="Dark mode"
                      ToolTip="Switch between light and dark mode"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountTextBlock" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusTextBlock" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" />
        </Grid>

        <DataGrid x:Name="ProductsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  RowHeaderWidth="0"
                  Margin="0,0,0,12">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding DetailsTooltip}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Select"
                                        Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="70" />
                <DataGridTextColumn Header="Product Code" Binding="{Binding ProductCode}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" IsReadOnly="True" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="1.2*" IsReadOnly="True" />
                <DataGridTextColumn Header="Install Date" Binding="{Binding InstallDate}" Width="1.2*" IsReadOnly="True" />
                <DataGridTextColumn Header="Source Status" Binding="{Binding SourceStatus}" Width="1.5*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="RunButton" Content="Run Selected Method" Margin="0,0,12,0" IsEnabled="False" />
            <Button x:Name="CleanupButton" Content="Clean Orphaned Entries" Margin="0,0,12,0" IsEnabled="False" />
        </StackPanel>

        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top" Text="Activity Log" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBox x:Name="LogTextBox"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Consolas"
                     Style="{DynamicResource LogTextBoxStyle}" />
        </DockPanel>
    </Grid>
</Window>
