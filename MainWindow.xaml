<Window
    x:Class="AppSweep.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AppSweep"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AppSweep"
    Width="1180"
    Height="820">
    <Grid x:Name="RootGrid" Padding="16" RowSpacing="12" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Search:" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     PlaceholderText="Search by name, product code, version, or date"
                     TextChanged="SearchBox_TextChanged" />
            <Button x:Name="RefreshButton"
                    Grid.Column="2"
                    Content="Refresh List"
                    Click="RefreshButton_Click" />
            <Button x:Name="SelectAllButton"
                    Grid.Column="3"
                    Content="Select All"
                    Click="SelectAllButton_Click" />
            <Button x:Name="DeselectAllButton"
                    Grid.Column="4"
                    Content="Deselect All"
                    Click="DeselectAllButton_Click" />
            <ProgressRing x:Name="LoadingRing"
                          Grid.Column="5"
                          IsActive="False"
                          Width="28"
                          Height="28"
                          VerticalAlignment="Center" />
            <TextBlock Grid.Column="6"
                       x:Name="CountText"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12" Padding="6,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="" Width="32" />
            <TextBlock Grid.Column="1" Text="Product Code" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Name" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Version" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="Install Date" FontWeight="SemiBold" />
        </Grid>

        <ListView Grid.Row="2"
                  x:Name="ProductsListView"
                  ItemsSource="{x:Bind FilteredProducts, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:InstalledProduct">
                    <Border Padding="6,6,6,6" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ProductCode}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Version}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind InstallDate}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <Button x:Name="UninstallButton"
                    Content="Uninstall Selected"
                    IsEnabled="False"
                    Click="UninstallButton_Click" />
            <Button x:Name="ForceRemoveButton"
                    Content="Force Remove Selected"
                    IsEnabled="False"
                    Click="ForceRemoveButton_Click" />
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <Grid Grid.Row="4" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Activity Log" FontWeight="SemiBold" />
            <TextBox x:Name="LogTextBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     IsTextSelectionEnabled="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />
        </Grid>
    </Grid>
</Window>
